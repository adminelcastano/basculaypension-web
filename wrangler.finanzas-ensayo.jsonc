{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Configuración exclusivamente de compilación del panel integral en ensayo.
  // NO DESPLEGAR: sustituir el database_id por una D1 NUEVA, VACÍA y autorizada.
  // Nunca vincular castano-facturas ni la D1 sintética del diagnóstico.
  "name": "castano-finanzas-app-ensayo",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/panel", "/panel/*", "/expediente/*", "/turno", "/turno/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "D1_NUEVA_PENDIENTE_NO_DESPLEGAR",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "kv_namespaces": [{
    "binding": "FILES",
    "id": "06093f14870a4df89ab81b0246dec74a"
  }],
  "triggers": { "crons": [] },
  "vars": {
    "ADMIN_EMAILS": "administracion@basculaypension.com",
    "TURNO_EMAILS": "",
    "ACCESS_TEAM_DOMAIN": "odd-math-3ae5.cloudflareaccess.com",
    "ACCESS_AUD": "61906c005bbf2883bafb408d577211fe96ceef4e7ddc9b0a179e484fef8e390b"
  },
  "limits": { "cpu_ms": 5000 },
  "rules": [
    { "type": "Data", "globs": ["**/*.webp"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.css", "**/cliente/*.js"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
