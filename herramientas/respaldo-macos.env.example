# COPIAR MANUALMENTE a ~/.config/elcastano-d1/backup.env en macOS.
# Este archivo no debe incluir tokens ni claves privadas.
# Sustituir las rutas por directorios del propio Mac FUERA del repositorio.
BACKUP_DEST="$HOME/Library/Application Support/ElCastano/D1-Cifrados"
# Sólo clave pública age1... originada en Windows.
AGE_RECIPIENT="age1_REEMPLAZAR_POR_CLAVE_PUBLICA"
# Remote rclone configurado manualmente con la carpeta privada como root_folder_id.
BACKUP_DRIVE_REMOTE="castano-d1-backups:"
