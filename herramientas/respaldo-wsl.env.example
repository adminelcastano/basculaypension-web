# Plantilla para ~/.config/elcastano-d1/backup.env en Ubuntu/WSL.
# No guardar aquí tokens, contraseñas ni claves privadas.
# La clave PRIVADA se custodia en la Mac, no en este Windows.
BACKUP_DEST="$HOME/.local/share/elcastano-d1/cifrados"
AGE_RECIPIENT="age1_REEMPLAZAR_POR_CLAVE_PUBLICA_MAC"
BACKUP_DRIVE_REMOTE="castano-d1-backups:"
# El lanzador y el programador rechazan cualquier ejecución si sigue en NO.
BACKUP_ACTIVE="NO"
