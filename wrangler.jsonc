{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basculaypension-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/panel", "/panel/*", "/expediente/*", "/turno", "/turno/*"]
  },
  // Solicitudes de factura (se crea sola al desplegar)
  "d1_databases": [{ "binding": "DB", "database_name": "castano-facturas" }],
  // Fotos de tickets y constancias (se crea sola al desplegar)
  "kv_namespaces": [{ "binding": "FILES" }],
  // Borrado diario de archivos con más de 90 días tras facturar o rechazar
  "triggers": { "crons": ["17 9 * * *", "47 14 * * *", "*/10 * * * *"] },
  "vars": {
    "ADMIN_EMAILS": "administracion@basculaypension.com",
    // Cuenta de la tablet del encargado de turno (solo entra a /turno)
    "TURNO_EMAILS": "entrada@basculaypension.com",
    // Script de la hoja de ingresos (sin INGRESOS_TOKEN, que es secreto, no entrega datos)
    "INGRESOS_URL": "https://script.google.com/macros/s/AKfycbwXnHU8w6OMJFfCbaLHicr3VNevZ05-qtCr_ZiOxZQUjeiAW17bsOMk4JkY_WCIyerz/exec",
    "ACCESS_TEAM_DOMAIN": "odd-math-3ae5.cloudflareaccess.com",
    "ACCESS_AUD": "a0dcf0e931c7b6a7b64cae835ae329cb05fc3bdbdc972c1af99c4619ee3fba1d"
  },
  // Plan Workers Paid: hasta 30 s de CPU por petición (en el plan gratuito este ajuste no se acepta
  // y el despliegue falla, así que también sirve para confirmar que el plan está activo)
  "limits": { "cpu_ms": 30000 },
  // Lectura de fotos de tickets (Workers AI: 10 000 neuronas diarias gratis). Con Workers Paid
  // el excedente se cobraría; src/neuronas.js corta a las 9 000 para que eso no pase.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
