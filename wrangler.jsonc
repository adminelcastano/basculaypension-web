{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basculaypension-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/panel", "/panel/*"]
  },
  // Solicitudes de factura (se crea sola al desplegar)
  "d1_databases": [{ "binding": "DB", "database_name": "castano-facturas" }],
  // Fotos de tickets y constancias (se crea sola al desplegar)
  "kv_namespaces": [{ "binding": "FILES" }],
  // Borrado diario de archivos con más de 90 días tras facturar o rechazar
  "triggers": { "crons": ["17 9 * * *"] },
  "vars": {
    "ADMIN_EMAILS": "administracion@basculaypension.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
