# Estado local de Wrangler / Miniflare: nunca versionar.
.wrangler/

# Configuración y credenciales locales (mantener plantillas sin secretos).
.dev.vars*
.env
.env.*
!.env.example

# Dependencias y archivos generados localmente.
node_modules/
*.log
.DS_Store

# Respaldos, exportaciones SQL y copias SQLite: siempre fuera del repositorio.
respaldos/
backups/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sql.age
*.sql.gz
*.sql.enc
