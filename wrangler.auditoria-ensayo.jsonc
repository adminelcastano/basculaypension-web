{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ENSAYO TEMPORAL PRIVADO: solo D1/KV nuevas y Access exclusivo.
  // NO modificar este archivo para apuntar a recursos productivos o al PR #18.
  "name": "castano-auditoria-privada-20261019",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/panel", "/panel/*", "/expediente/*", "/turno", "/turno/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "castano-auditoria-privada-d1-20261019",
    "database_id": "4bc6252e-af96-4d96-b1f2-31c6d4ef3416"
  }],
  "kv_namespaces": [{
    "binding": "FILES",
    "id": "5ff5e8d9cd38441f8cc2479fd2425551"
  }],
  "triggers": { "crons": [] },
  "vars": {
    "ENSAYO_AUDITORIA": "1",
    "ADMIN_EMAILS": "administracion@basculaypension.com",
    "TURNO_EMAILS": "",
    "ACCESS_TEAM_DOMAIN": "odd-math-3ae5.cloudflareaccess.com",
    "ACCESS_AUD": "dad68cb096a5ad89414cdf91567fe78c1c6ac096c131724b55b7c5eed5a4d093"
  },
  "limits": { "cpu_ms": 5000 },
  "rules": [
    { "type": "Data", "globs": ["**/*.webp"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.css", "**/cliente/*.js"], "fallthrough": true }
  ],
  "observability": { "enabled": false }
}
